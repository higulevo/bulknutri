generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements Movement[]
  sales     Sale[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  brand       String?
  description String?
  image       String?
  costPrice   Float     @default(0)
  salePrice   Float     @default(0)
  hasVariants Boolean   @default(true)
  stock       Int       @default(0)   // usado só quando hasVariants=false
  minStock    Int       @default(5)   // usado só quando hasVariants=false
  categoryId  Int?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id])
  variants  Variant[]
  saleItems SaleItem[]
  movements Movement[]
}

model Variant {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  sku       String?
  price     Float?
  stock     Int      @default(0)
  minStock  Int      @default(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  Movement[]
  saleItems  SaleItem[]
}

model Movement {
  id        Int      @id @default(autoincrement())
  variantId Int?
  productId Int?
  userId    Int
  type      String   // ENTRADA | SAIDA | AJUSTE | VENDA | ESTORNO
  quantity  Int
  note      String?
  saleId    Int?
  createdAt DateTime @default(now())

  variant Variant? @relation(fields: [variantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  sale    Sale?    @relation(fields: [saleId], references: [id])
}

model Sale {
  id            Int        @id @default(autoincrement())
  userId        Int
  customerName  String?
  customerPhone String?
  discount      Float      @default(0)
  total         Float
  paymentMethod String
  paymentStatus String     @default("PENDENTE")
  note          String?
  paidAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     SaleItem[]
  movements Movement[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  variantId Int?
  productId Int?
  quantity  Int
  unitPrice Float
  total     Float

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
}
