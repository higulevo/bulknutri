# Preencha com os valores reais e salve como ".env" (sem o .example)

# String de conexão do PostgreSQL: postgresql://usuario:senha@localhost:5432/banco
DATABASE_URL="postgresql://bulknutri_user:SUA_SENHA_AQUI@localhost:5432/bulknutri?schema=public"

# Gere a sua com: openssl rand -hex 32
JWT_SECRET="GERE_UM_VALOR_UNICO_AQUI"

PORT=3001

# Domínio do frontend (usado no CORS)
FRONTEND_URL="https://seudominio.com.br"

# Credenciais do Cloudinary (armazenamento das imagens de produtos)
# Crie uma conta gratuita em https://cloudinary.com e pegue esses 3 valores no Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

NODE_ENV=production
